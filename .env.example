########################################
# Telegram
########################################
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

########################################
# Limits and performance
########################################
# Upload limit to Telegram (bytes), default 50MB (Bot API limit)
MAX_UPLOAD_TO_TELEGRAM_BYTES=52428800
# Links one user can have processing at the same time
MAX_CONCURRENT_PER_USER=3
# Media download timeout (seconds)
HTTP_TIMEOUT_SECONDS=120

########################################
# Optional
########################################
# Proxy for the TikTok downloader, if TikTok blocks the server IP
# TIKTOK_PROXY=http://user:pass@host:port
# Where each user's /language choice is saved (default: data/languages.json)
# LANGUAGE_STORE_PATH=data/languages.json

# Note: the bot doesn't store media on disk; files are downloaded into memory and uploaded.
