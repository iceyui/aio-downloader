########################################
# Telegram
########################################
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

########################################
# Batasan dan kinerja
########################################
# Batas upload ke Telegram (bytes), default 50MB (batas Bot API)
MAX_UPLOAD_TO_TELEGRAM_BYTES=52428800
# Jumlah link yang boleh diproses bersamaan per user
MAX_CONCURRENT_PER_USER=3
# Timeout unduhan media (detik)
HTTP_TIMEOUT_SECONDS=120

########################################
# Opsional
########################################
# Proxy untuk downloader TikTok, kalau IP server diblokir TikTok
# TIKTOK_PROXY=http://user:pass@host:port

# Catatan: bot tidak menyimpan file di disk, unduhan disimpan di memori lalu diupload.
